# Copie para .env e preencha os valores reais.
# Nunca commite o .env — ele já está no .gitignore.
#
# No GitLab CI/CD, cadastre cada variável em:
# Settings > CI/CD > Variables (marcar como Masked e Protected)

# Banco de dados
DB_NAME=wssdb
DB_USERNAME=wss
DB_PASSWORD=troque-por-senha-forte

# AWS (usado pelo deploy.sh)
AWS_PROFILE=wsssguardo

# Observabilidade
GRAFANA_PASSWORD=troque-por-senha-forte

# Cognito — obrigatório quando SECURITY_AUTH_DISABLED=false
# Valores gerados pelo Terraform (terraform output cognito_*)
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Auth local (deixe false para dev com docker compose)
SECURITY_AUTH_DISABLED=true
